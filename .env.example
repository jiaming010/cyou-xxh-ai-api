# =============================================================================
# 基础配置
# =============================================================================

# 时区
TZ=Asia/Shanghai
# 端口号
# PORT=3000
# 前端基础URL
# FRONTEND_BASE_URL=https://example.com

# =============================================================================
# 数据库配置
# =============================================================================

# --- 主数据库 ---
DB_HOST=masked-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=
DB_NAME=your_db_name
# 由上方变量自动组装，也可直接覆盖
SQL_DSN=${DB_USER}:${DB_PASSWORD}@tcp(${DB_HOST}:${DB_PORT})/${DB_NAME}?charset=utf8mb4&parseTime=True&loc=Local

# --- 日志数据库 ---
LOG_DB_HOST=masked-host
LOG_DB_PORT=3306
LOG_DB_USER=your-log-db-user
LOG_DB_PASSWORD=
LOG_DB_NAME=your_log_db_name
# 由上方变量自动组装，也可直接覆盖
LOG_SQL_DSN=${LOG_DB_USER}:${LOG_DB_PASSWORD}@tcp(${LOG_DB_HOST}:${LOG_DB_PORT})/${LOG_DB_NAME}?charset=utf8mb4&parseTime=True&loc=Local

# SQLite数据库路径（使用 SQLite 时启用）
# SQLITE_PATH=/masked/path/database.db

# 连接池参数
# SQL_MAX_IDLE_CONNS=100
# SQL_MAX_OPEN_CONNS=1000
# SQL_MAX_LIFETIME=60

# =============================================================================
# Redis 配置
# =============================================================================

REDIS_HOST=masked-host
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 由上方变量自动组装，也可直接覆盖
REDIS_CONN_STRING=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# =============================================================================
# 日志与批量更新
# =============================================================================

ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
# BATCH_UPDATE_INTERVAL=5

# =============================================================================
# 调试相关配置
# =============================================================================

# ENABLE_PPROF=true
# DEBUG=true
# Pyroscope 配置
# PYROSCOPE_URL=http://example.local:4040
# PYROSCOPE_APP_NAME=your-app-name
# PYROSCOPE_BASIC_AUTH_USER=your-user
# PYROSCOPE_BASIC_AUTH_PASSWORD=your-password
# PYROSCOPE_MUTEX_RATE=5
# PYROSCOPE_BLOCK_RATE=5
# HOSTNAME=masked-hostname

# =============================================================================
# 缓存配置
# =============================================================================

# SYNC_FREQUENCY=60
# MEMORY_CACHE_ENABLED=true
# CHANNEL_UPDATE_FREQUENCY=30

# =============================================================================
# 任务和功能配置
# =============================================================================

# UPDATE_TASK=true

# =============================================================================
# 超时设置
# =============================================================================

# 所有请求超时时间，单位秒，默认为0 表示不限制
# RELAY_TIMEOUT=0
# 流模式无响应超时时间，单位秒
# STREAMING_TIMEOUT=300

# =============================================================================
# TLS / HTTP
# =============================================================================

# TLS_INSECURE_SKIP_VERIFY=false

# =============================================================================
# 模型特定配置
# =============================================================================

# GEMINI_VISION_MAX_IMAGE_NUM=16
# COHERE_SAFETY_SETTING=NONE
# GET_MEDIA_TOKEN=true
# GET_MEDIA_TOKEN_NOT_STREAM=false
# DIFY_DEBUG=true

# =============================================================================
# 会话与安全
# =============================================================================

# SESSION_SECRET=your-session-secret
# GENERATE_DEFAULT_TOKEN=false

# =============================================================================
# LinuxDo 配置
# =============================================================================

LINUX_DO_TOKEN_ENDPOINT=https://example.com/oauth2/token
LINUX_DO_USER_ENDPOINT=https://example.com/api/user

# =============================================================================
# 节点配置
# =============================================================================

# 如果是主节点则为 master
# NODE_TYPE=master

# =============================================================================
# 信任域名
# =============================================================================

# 可信任重定向域名列表（逗号分隔，支持子域名匹配）
# 示例: example.com,example.org
# TRUSTED_REDIRECT_DOMAINS=example.com,example.org